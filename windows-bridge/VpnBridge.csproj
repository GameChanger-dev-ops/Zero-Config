<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ZeroConfigBridge</AssemblyName>
    <RootNamespace>ZeroConfigBridge</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);VpnBridge.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Dependencies\tun2socks.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Dependencies\tun2socks.exe')" />
    <None Include="Dependencies\wintun.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Dependencies\wintun.dll')" />
  </ItemGroup>

</Project>