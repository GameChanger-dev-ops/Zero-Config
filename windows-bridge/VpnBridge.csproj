<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ZeroConfigBridge.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ZeroConfig.ico</ApplicationIcon>
    <AssemblyName>ZeroConfigBridge</AssemblyName>
    <RootNamespace>ZeroConfigBridge</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);VpnBridge.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ZeroConfig.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\ZeroConfig.ico" />
    <None Include="Dependencies\tun2socks.exe" Link="tun2socks.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Dependencies\tun2socks.exe')" />
    <None Include="Dependencies\wintun.dll" Link="wintun.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Dependencies\wintun.dll')" />
  </ItemGroup>

</Project>